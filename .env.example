# Copy to .env for local configuration. Collection does not require a model key.
PQ_SERVICE_NAME="PrismQuant Political Monitoring API"
PQ_ENVIRONMENT=development
PQ_HOST=127.0.0.1
PQ_PORT=8000
# Exact browser frontend origins, JSON array. Empty disables cross-origin access.
# localhost and 127.0.0.1 are different origins; no trailing slash.
# PQ_CORS_ORIGINS='["http://localhost:5173"]'
PQ_CORS_ORIGINS='[]'

# Optional keyword administrator bearer token (32+ random characters).
# Empty keeps all keyword administration HTTP endpoints disabled.
# Generate locally; never use a model API key or commit the real value.
PQ_KEYWORD_ADMIN_TOKEN=''
# Optional independent reviewer IDs/tokens, JSON object inside a quoted .env value.
# Leave empty until real reviewers are ready; use distinct random 32..256 character
# tokens for each person, different from the keyword administrator token.
PQ_ANNOTATION_REVIEWER_TOKENS=''
# Optional private OpenRouter credential for explicitly approved finite trials.
# Keep the real value in local .env only. No model calls on server startup.
PQ_OPENROUTER_API_KEY=''

# Local PostgreSQL connection. Fill only in .env; never commit real credentials.
PQ_DB_HOST=127.0.0.1
PQ_DB_PORT=5432
PQ_DB_NAME=prismquant_political
PQ_DB_USER=prismquant_app
PQ_DB_PASSWORD=''

# Optional data-source credential checks; OFFLINE replay needs none of these.
# Keep actual values only in local .env, never in the access manifest or GitHub.
# These are separate data credentials, not an OpenRouter/model API key.
# PQ_TRUTH_1322_REST_KEY=''
# PQ_TRUTH_1322_WS_KEY=''
# PQ_TRUTH_1322_WS_PATH=''
# Optional independent source-directory review credential; blank keeps HTTP writes disabled.
PQ_SOURCE_CATALOG_ADMIN_TOKEN=

# Optional free reminder processing; requires migration 0022 and explicit published channels.
PQ_REMINDER_PROCESSING_ENABLED=false
PQ_REMINDER_POLL_SECONDS=10

# Optional local CPU vector indexing; install requirements-vector.txt and download
# pinned public model artifacts explicitly before enabling. No paid model API.
PQ_KNOWLEDGE_INDEXING_ENABLED=false
PQ_KNOWLEDGE_POLL_SECONDS=30

# Enable only after source review and monitor_speed controls. No model calls.
PQ_FAST_DISCOVERY_ENABLED=false

# The supervised launcher sets production/research for its API child.
# Use operations only in a trusted development environment.
PQ_CONSOLE_MODE=research

# Optional self-hosted SearXNG; empty preserves official catalog navigation.
# Enable JSON output on the search service before configuring this local origin.
PQ_SEARXNG_URL=
